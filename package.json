{
	"name": "mtgcollector",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"predev": "node scripts/build-detect-worker.mjs",
		"dev": "vite dev",
		"import-cards": "npx tsx src/lib/server/seed.ts",
		"import-new-cards": "npx tsx src/lib/server/import-new-cards.ts",
		"backfill-prices": "npx tsx src/lib/server/backfill-prices.ts",
		"hash-art": "npx tsx src/lib/server/hash-art.ts",
		"import-names": "npx tsx src/lib/server/import-names.ts",
		"build:worker": "node scripts/build-detect-worker.mjs",
		"prebuild": "node scripts/build-detect-worker.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"overrides": {
		"cookie": "0.7.2",
		"@esbuild-kit/core-utils": {
			"esbuild": "0.25.4"
		}
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.56.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/better-sqlite3": "^7.6.13",
		"drizzle-kit": "^0.31.10",
		"esbuild": "^0.25.12",
		"playwright": "^1.56.1",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.1.9"
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"@tailwindcss/vite": "^4.2.2",
		"arctic": "^3.7.0",
		"better-sqlite3": "^12.8.0",
		"chart.js": "^4.5.1",
		"drizzle-orm": "^0.45.2",
		"sharp": "^0.35.4",
		"tailwindcss": "^4.2.2",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	}
}
