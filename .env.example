# MTG Collector — environment variables
# Copy to .env and fill in the values. Never commit .env.

# ------------------------------------------------------------------
# Required: Google OAuth (console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {ORIGIN}/auth/callback/google
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ORIGIN=http://localhost:5173
# Production adapter limit, including multipart overhead for 10 MB imports.
# Export this to the Node process (e.g. the service's EnvironmentFile).
BODY_SIZE_LIMIT=12M

# ------------------------------------------------------------------
# Optional: the user whose account is treated as the admin. Must match
# the email on their Google profile (case-insensitive).
# ------------------------------------------------------------------
ADMIN_EMAIL=

# ------------------------------------------------------------------
# Optional: Cloudflare Turnstile, the captcha on /contact and in front of
# making a deck public. Create a widget for this hostname in the Cloudflare
# dashboard (Turnstile, "Managed" mode) and copy both keys. It is on only
# when both are set; with either blank there is no captcha anywhere.
# ------------------------------------------------------------------
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------------
# Notes
# ------------------------------------------------------------------
# - The server-side secret for keyed hashes (contact form) lives in
#   data/secret-key.hex and is generated on first use. Back it up
#   together with the database.

# ------------------------------------------------------------------
# Optional: serve the scanner's browser libraries (OpenCV.js, Tesseract.js,
# language data) yourself instead of from public CDNs. Point this at a base
# URL with the layout documented in src/lib/scanner/assets.ts, e.g. "/vendor"
# for files placed under static/vendor/ (gitignored). Leave blank for CDNs.
# ------------------------------------------------------------------
PUBLIC_SCANNER_ASSETS_URL=
